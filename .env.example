# Copy to .env.local and configure real values privately. Never commit real keys.
# Credentials and backend settings are server-only; never prefix keys with NEXT_PUBLIC_.
# The nonsecret frontend mock flag below is the only public setting.

# Exact browser origin, including scheme and port, with no trailing slash.
# On Appwrite Sites use APP_ORIGIN=https://agent-force.tech.
# Google OAuth credentials remain in Appwrite Console; no Google env vars needed.
APP_ORIGIN=http://localhost:3000
# Display currency for the demo; coordinate this setting with the frontend.
APP_CURRENCY=PKR

# Copy the ACTUAL regional endpoint (including /v1) and project ID from Console.
# No global endpoint or guessed region is used by the backend.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
# Runtime scopes only: sessions.write, rows.read, rows.write.
APPWRITE_API_KEY=
# Separate local provisioning key; NEVER configure this key on the Site runtime.
# Scopes: databases.read/write, tables.read/write, columns.read/write,
# indexes.read/write. Runtime row scopes are not needed by the setup script.
APPWRITE_SETUP_API_KEY=
# Create these exact database/table IDs, or update these values to match yours.
APPWRITE_DATABASE_ID=agentforce
APPWRITE_PRODUCTS_TABLE_ID=products
APPWRITE_QUOTATIONS_TABLE_ID=quotations
APPWRITE_AGENT_RUNS_TABLE_ID=agent_runs
APPWRITE_ACTIVITY_TABLE_ID=activity_logs
APPWRITE_RATE_LIMITS_TABLE_ID=rate_limits
APPWRITE_SETTINGS_TABLE_ID=business_settings
APPWRITE_DEALERS_TABLE_ID=dealers
APPWRITE_RESTOCK_ORDERS_TABLE_ID=restock_orders
# Exact Appwrite User ID of the business owner receiving demo inventory.
SEED_OWNER_USER_ID=

# UI-only demo data without Appwrite or login. Keep false for the real AI demo.
NEXT_PUBLIC_USE_MOCK=false

# Providers: none, anthropic, openai, or gemini. Missing/failed LLM uses fallback.
LLM_PROVIDER=none
GEMINI_API_KEY=
# Select an available function-calling Gemini model in your Google AI Studio account.
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional model override for all providers. Base URL applies only to OpenAI/Anthropic.
LLM_BASE_URL=
LLM_MODEL=
# Demo financial settings only. This is NOT a verified legal tax rate.
TAX_RATE=0.18
# Only enable after verifying trusted proxy strips incoming client IP headers.
# TRUST_PROXY_IP_HEADERS=true
# Each provider call must respect the remaining overall workflow budget.
LLM_TIMEOUT_MS=12000
AGENT_RUN_TIMEOUT_MS=24000

# Appwrite Sites reserves APPWRITE_* variable names. Set the following aliases
# in Site environment settings, with the ACTUAL same project configuration.
# Site-injected x-appwrite-key is used only when APPWRITE_SITE_ID is present.
# Grant the Site only sessions.write, rows.read, rows.write; no stored key needed.
# AGENTFORCE_APPWRITE_ENDPOINT=
# AGENTFORCE_APPWRITE_PROJECT_ID=
# AGENTFORCE_APPWRITE_DATABASE_ID=agentforce
# Optional server-secret fallback if Site ephemeral keys are unavailable:
# AGENTFORCE_APPWRITE_API_KEY=
