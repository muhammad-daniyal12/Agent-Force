# Copy to .env.local and replace placeholders locally. Never commit real keys.
# All variables below are server-only; do not add NEXT_PUBLIC_ to their names.

# Exact browser origin, including scheme and port, with no trailing slash.
# Set the deployed HTTPS origin in the deployment environment.
APP_ORIGIN=http://localhost:3000
# MVP currencies: PKR or USD. One currency per deployment; both use 2 decimals.
APP_CURRENCY=PKR

# Appwrite Console: copy the regional API endpoint and project ID.
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=replace_with_project_id
# Runtime scopes only: sessions.write, rows.read, rows.write.
APPWRITE_API_KEY=replace_with_server_api_key
# Create these exact database/table IDs, or update these values to match yours.
APPWRITE_DATABASE_ID=agentforce
APPWRITE_PRODUCTS_TABLE_ID=products
APPWRITE_REQUESTS_TABLE_ID=customer_requests
APPWRITE_QUOTES_TABLE_ID=quotes
APPWRITE_AGENT_RUNS_TABLE_ID=agent_runs

# Pick an LLM provider and model; backend implementation must supply its adapter.
# BASE_URL is the provider API base, not a browser-configurable destination.
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL=replace_with_model_id
# Each provider call must respect the remaining overall workflow budget.
LLM_TIMEOUT_MS=15000
AGENT_RUN_TIMEOUT_MS=45000
